      "gates": ["reproduction-gate", "evidence-gate"],
      "artifacts": ["bug-analysis.md", "evidence/README.md"],
      "evidence": []
    },
    {
      "name": "Diagnose",
      "owner": "tech-lead",
      "status": "pending",
      "gates": ["technical-gate", "decision-gate"],
      "artifacts": ["bug-analysis.md", "decision-log.md"],
      "evidence": []
    },
    {
      "name": "Fix",
      "owner": "frontend-engineer,backend-engineer",
      "status": "pending",
      "gates": ["implementation-gate"],
      "artifacts": ["implementation-plan.md"],
      "evidence": []
    },
    {
      "name": "Regression",
      "owner": "qa-engineer",
      "status": "pending",
      "gates": ["test-gate", "evidence-gate", "verification-gate"],
      "artifacts": ["test-plan.md", "evidence/README.md"],
      "evidence": []
    },
    {
      "name": "Delivery",
      "owner": "delivery-manager",
      "status": "pending",
      "gates": ["handoff-gate", "delivery-gate", "verification-gate"],
      "artifacts": ["workflow-status.json", "delivery-summary.md"],
      "evidence": []
    }
  ]
