{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-work-team.local/schemas/task.schema.json",
  "title": "AI Work Team Task Plan",
  "type": "object",
  "required": ["schemaVersion", "goalId", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "goalId": {
      "type": "string",
      "pattern": "^goal-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "namedContract": {
      "type": "object",
      "required": ["name", "sourceOrDestination", "schemaOrFormat"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sourceOrDestination": {
          "type": "string",
          "minLength": 1
        },
        "schemaOrFormat": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "taskId",
        "milestoneId",
        "title",
        "objective",
        "capability",
        "ownerRole",
        "dependsOn",
        "inputs",
        "outputs",
        "acceptanceCriteria",
        "evidenceRequirements",
        "fileOwnership",
        "riskLevel",
        "executionMode",
        "decisionMode",
        "retryPolicy",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^task-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "milestoneId": {
          "type": "string",
          "pattern": "^milestone-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "ownerRole": {
          "$ref": "#/$defs/roleId"
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^task-[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedContract"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/namedContract"
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "criterion", "verification"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^acceptance-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "evidenceRequirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fileOwnership": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "riskLevel": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "executionMode": {
          "type": "string",
          "enum": ["sequential", "parallel"]
        },
        "decisionMode": {
          "type": "string",
          "enum": ["auto", "notify", "approval"]
        },
        "retryPolicy": {
          "type": "object",
          "required": ["maxAttempts", "backoff", "onExhausted"],
          "additionalProperties": false,
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "backoff": {
              "type": "string",
              "enum": ["none", "linear", "exponential"]
            },
            "onExhausted": {
              "type": "string",
              "enum": ["block", "escalate", "replan"]
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "ready",
            "in_progress",
            "blocked",
            "review",
            "completed",
            "cancelled"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "riskLevel": {
                "enum": ["high", "critical"]
              }
            },
            "required": ["riskLevel"]
          },
          "then": {
            "properties": {
              "decisionMode": {
                "const": "approval"
              }
            }
          }
        }
      ]
    },
    "roleId": {
      "type": "string",
      "enum": [
        "product-manager",
        "operations-manager",
        "ui-designer",
        "tech-lead",
        "frontend-engineer",
        "backend-engineer",
        "qa-engineer",
        "delivery-manager"
      ]
    }
  }
}
