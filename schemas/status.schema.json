{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Work Team Workflow Status",
  "type": "object",
  "required": ["workflow", "requirementFolder", "complexityLevel", "executionProfile", "verificationLevel", "rolePlan", "updatedAt", "stages"],
  "additionalProperties": false,
  "properties": {
    "workflow": {
      "type": "string"
    },
    "requirementFolder": {
      "type": "string"
    },
    "complexityLevel": {
      "type": "string",
      "enum": ["S", "M", "L", "XL"]
    },
    "executionProfile": {
      "type": "string",
      "enum": ["lightweight", "standard", "assurance"]
    },
    "verificationLevel": {
      "type": "string",
      "enum": ["V0", "V1", "V2", "V3", "V4"]
    },
    "rolePlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "mode", "reason", "stages"],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": ["active", "consulted", "not_applicable"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "updatedAt": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "owner", "status", "gates", "artifacts", "evidence"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "blocked", "review", "completed"]
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
