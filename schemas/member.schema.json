{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Work Team Member",
  "type": "object",
  "required": ["id", "name", "role", "when_to_load", "primary_outputs", "quality_gates"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "when_to_load": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
