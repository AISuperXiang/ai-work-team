{
  "name": "ai-work-team",
  "version": "0.3.0",
  "private": true,
  "description": "A product-engineering expert team skill with role members, workflows, commands, standards, templates, and structure validation.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "validate": "node scripts/validate-structure.js",
    "validate:structure": "node scripts/validate-structure.js",
    "validate:contracts": "node scripts/validate-contracts.js",
    "validate:workspaces": "node scripts/validate-contracts.js --all-workspaces",
    "test:behavior": "node --test test/*.test.js",
    "test:mutation": "node scripts/run-mutation-tests.js",
    "test:ci": "npm test && npm run test:mutation",
    "skills:list": "node scripts/list-external-skills.js",
    "skills:install": "node scripts/install-external-skills.js",
    "context:build": "node scripts/build-context.js",
    "test": "npm run validate:structure && npm run validate:contracts && npm run test:behavior"
  },
  "license": "UNLICENSED"
}
